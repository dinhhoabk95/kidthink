{
  "name": "@mindkid/monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24",
    "pnpm": ">=11"
  },
  "packageManager": "pnpm@11.16.0",
  "scripts": {
    "prepare": "lefthook install",
    "dev": "pnpm --filter @mindkid/web dev",
    "dev:admin": "pnpm --filter @mindkid/admin dev",
    "dev:worker": "pnpm --filter @mindkid/worker dev",
    "dev:all": "pnpm --parallel --filter './apps/*' dev",
    "build": "pnpm --recursive --if-present run build",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "lint:deps": "depcruise apps packages scripts --config .dependency-cruiser.cjs",
    "typecheck": "node scripts/typecheck/typecheck-gate.ts",
    "typecheck:update": "node scripts/typecheck/typecheck-gate.ts --update",
    "check:taxonomy-docs": "tsx scripts/taxonomy/sync-taxonomy-docs.ts --check",
    "gen:taxonomy-docs": "tsx scripts/taxonomy/sync-taxonomy-docs.ts --write",
    "verify": "tsx scripts/verify.ts",
    "test": "NODE_OPTIONS=--max-old-space-size=4096 vitest run --bail 1",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:deploy": "bash infra/scripts/tests/run.sh",
    "check": "bash scripts/check.sh",
    "check:fast": "bash scripts/check.sh --fast",
    "db:generate": "pnpm --filter @mindkid/db run generate",
    "db:migrate": "pnpm --filter @mindkid/db run migrate",
    "db:seed": "pnpm --filter @mindkid/db run seed && pnpm --filter @mindkid/content-build run seed:all",
    "db:seed:foundational": "pnpm --filter @mindkid/db run seed",
    "db:seed:content": "pnpm --filter @mindkid/content-build run seed:content",
    "db:reset-content": "pnpm --filter @mindkid/content-build run reset-content",
    "db:restore": "pnpm --filter @mindkid/worker run restore",
    "services": "tsx scripts/check-services.ts",
    "qa:capture": "tsx scripts/qa/capture-engines.ts",
    "deploy": "tsx scripts/deploy/cli.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@mindkid/config": "workspace:*",
    "@types/node": "catalog:",
    "dependency-cruiser": "catalog:",
    "drizzle-orm": "catalog:",
    "ioredis": "catalog:",
    "lefthook": "catalog:",
    "playwright": "catalog:",
    "postgres": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "ultracite": "catalog:",
    "vitest": "catalog:"
  }
}
