{
  "name": "@kidthink/monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24",
    "pnpm": ">=11"
  },
  "packageManager": "pnpm@11.16.0",
  "scripts": {
    "prepare": "lefthook install",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "lint:tokens": "node scripts/lint-tokens.ts",
    "lint:deps": "depcruise apps packages --config .dependency-cruiser.cjs",
    "lint:emoji": "node scripts/lint-emoji-affordance.ts",
    "lint:email": "node scripts/lint-email-content.ts",
    "typecheck:root": "tsc --noEmit -p tsconfig.json",
    "typecheck": "pnpm typecheck:root && pnpm --recursive run typecheck",
    "check": "pnpm lint && pnpm lint:tokens && pnpm lint:deps && pnpm lint:specs && pnpm lint:emoji && pnpm lint:email && pnpm check:progress && pnpm typecheck",
    "check:progress": "node scripts/check-progress.ts",
    "check:services": "node scripts/check-services.ts",
    "format": "biome format --write .",
    "test": "vitest run",
    "lint:specs": "node scripts/lint-specs.ts",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:generate": "pnpm --filter @kidthink/db exec drizzle-kit generate --config drizzle.config.ts",
    "db:migrate": "tsx packages/db/scripts/migrate.ts",
    "db:seed": "node packages/db/src/seed.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@types/node": "catalog:",
    "dependency-cruiser": "catalog:",
    "ioredis": "catalog:",
    "lefthook": "^2.1.10",
    "postgres": "catalog:",
    "typescript": "catalog:",
    "ultracite": "catalog:",
    "vitest": "catalog:"
  }
}
