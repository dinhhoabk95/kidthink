{
  "name": "@mindkid/monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.22.1",
    "pnpm": ">=11"
  },
  "packageManager": "pnpm@11.16.0",
  "scripts": {
    "prepare": "lefthook install",
    "dev": "pnpm --filter @mindkid/web dev",
    "dev:admin": "pnpm --filter @mindkid/admin dev",
    "dev:worker": "pnpm --filter @mindkid/worker dev",
    "dev:all": "pnpm --parallel --filter './apps/*' dev",
    "build": "pnpm --recursive --if-present run build",
    "format": "biome format --write .",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "lint:deps": "depcruise apps packages scripts --config .dependency-cruiser.cjs",
    "typecheck": "tsc --noEmit && pnpm --parallel --filter './apps/*' run typecheck",
    "test": "NODE_OPTIONS=--max-old-space-size=4096 vitest run --bail 1",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:deploy": "bash infra/scripts/tests/run.sh",
    "check": "pnpm lint && pnpm lint:deps && pnpm typecheck",
    "db:generate": "pnpm --filter @mindkid/db run generate",
    "db:migrate": "pnpm --filter @mindkid/db run migrate",
    "db:seed": "pnpm --filter @mindkid/db run seed && pnpm --filter @mindkid/content-build run seed:all",
    "deploy": "tsx scripts/deploy/cli.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@mindkid/config": "workspace:*",
    "@mindkid/content": "workspace:*",
    "@mindkid/content-build": "workspace:*",
    "@mindkid/game-engine": "workspace:*",
    "@mindkid/shared": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "dependency-cruiser": "catalog:",
    "ioredis": "catalog:",
    "lefthook": "catalog:",
    "playwright": "catalog:",
    "postgres": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "ultracite": "catalog:",
    "vitest": "catalog:"
  }
}
