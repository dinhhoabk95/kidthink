{
  "name": "@mindkid/monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24",
    "pnpm": ">=11"
  },
  "packageManager": "pnpm@11.16.0",
  "scripts": {
    "prepare": "lefthook install",
    "build": "pnpm --recursive --if-present run build",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "lint:tokens": "node scripts/lint-tokens.ts",
    "lint:deps": "depcruise apps packages --config .dependency-cruiser.cjs",
    "lint:env-names": "node scripts/lint-env-names.ts",
    "lint:migration-expand": "node scripts/lint-migration-expand.ts",
    "lint:shell": "node scripts/lint-shell-scripts.ts",
    "lint:emoji": "node scripts/lint-emoji-affordance.ts",
    "lint:email": "node scripts/lint-email-content.ts",
    "lint:gating": "node scripts/lint-gating.ts",
    "lint:telemetry-pii": "node scripts/lint-telemetry-pii.ts",
    "lint:analytics": "node scripts/lint-analytics-queries.ts",
    "lint:kid-surface": "node scripts/lint-kid-surface.ts",
    "lint:public-scripts": "node scripts/lint-public-scripts.ts",
    "lint:legal-review": "node scripts/lint-legal-review.ts",
    "lint:admin-routes": "node scripts/check-child-data-compliance-gates.ts",
    "lint:form-gates": "tsx scripts/lint-form-gates.ts",
    "lint:web-scale": "node scripts/check-web-scale-gate.ts",
    "typecheck:root": "tsc --noEmit -p tsconfig.json",
    "typecheck": "pnpm typecheck:root && pnpm --recursive run typecheck",
    "check:progress": "node scripts/check-progress.ts",
    "check:services": "node scripts/check-services.ts",
    "perf:budget": "node scripts/lint-perf-budget.ts",
    "format": "biome format --write .",
    "test": "NODE_OPTIONS=--max-old-space-size=4096 vitest run",
    "test:a11y": "vitest run packages/ui/tests/a11y.test.ts",
    "lint:specs": "node scripts/lint-specs.ts",
    "lint:rule-ids": "node scripts/lint-rule-ids.ts",
    "gen:check": "node scripts/check-progress.ts",
    "lint:user-vocabulary": "tsx scripts/lint-user-vocabulary.ts",
    "report:tags": "tsx scripts/report-tag-vocabulary.ts",
    "typecheck:web": "pnpm --filter @mindkid/web exec vue-tsc --noEmit -p .nuxt/tsconfig.app.json",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:generate": "pnpm --filter @mindkid/db exec drizzle-kit generate --config drizzle.config.ts",
    "db:migrate": "tsx packages/db/scripts/migrate.ts",
    "db:seed": "tsx packages/db/src/seed.ts",
    "seed:check": "tsx packages/db/src/seed-content/cli/seed-check.ts",
    "seed:content": "tsx packages/db/src/seed-content/cli/seed-content.ts",
    "seed:report": "tsx packages/db/src/seed-content/cli/seed-report.ts",
    "lint:type-safety": "node scripts/lint-type-safety.ts",
    "lint:route-validation": "node scripts/lint-route-validation.ts",
    "lint:thinking-coverage": "tsx scripts/lint-thinking-coverage.ts",
    "check:coverage": "tsx scripts/lint-thinking-coverage.ts",
    "lint:exemplar-matrix": "tsx scripts/lint-lesson-exemplar-matrix.ts",
    "gen:templates": "tsx scripts/gen-templates.ts",
    "lint:templates": "tsx scripts/lint-templates.ts",
    "check": "pnpm lint && pnpm lint:tokens && pnpm lint:deps && pnpm lint:specs && pnpm lint:rule-ids && pnpm lint:env-names && pnpm lint:env-example && pnpm lint:migration-expand && pnpm lint:shell && pnpm lint:user-vocabulary && pnpm lint:emoji && pnpm lint:email && pnpm lint:gating && pnpm lint:telemetry-pii && pnpm lint:analytics && pnpm lint:kid-surface && pnpm lint:public-scripts && pnpm lint:legal-review && pnpm lint:admin-routes && pnpm lint:form-gates && pnpm lint:web-scale && pnpm lint:type-safety && pnpm lint:route-validation && pnpm lint:thinking-coverage && pnpm lint:exemplar-matrix && pnpm lint:templates && pnpm check:progress && pnpm typecheck",
    "deploy": "tsx scripts/deploy/cli.ts release",
    "deploy:init": "tsx scripts/deploy/cli.ts init",
    "deploy:provision": "tsx scripts/deploy/cli.ts provision",
    "deploy:rollback": "tsx scripts/deploy/cli.ts rollback",
    "deploy:status": "tsx scripts/deploy/cli.ts status",
    "deploy:env": "tsx scripts/deploy/cli.ts env",
    "deploy:logs": "tsx scripts/deploy/cli.ts logs",
    "test:deploy": "bash infra/scripts/tests/run.sh",
    "gen:env": "node scripts/generate-env-example.ts",
    "lint:env-example": "node scripts/generate-env-example.ts --check"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@types/node": "catalog:",
    "dependency-cruiser": "catalog:",
    "drizzle-orm": "catalog:",
    "ioredis": "catalog:",
    "lefthook": "^2.1.10",
    "postgres": "catalog:",
    "typescript": "catalog:",
    "ultracite": "catalog:",
    "vitest": "catalog:"
  }
}
