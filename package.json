{
  "name": "@mindkid/monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.13.1",
    "pnpm": ">=12"
  },
  "packageManager": "pnpm@12.21.0",
  "scripts": {
    "prepare": "lefthook install",
    "dev": "pnpm --filter @mindkid/web dev",
    "dev:local": "DB_CONNECTION=sqlite pnpm --filter @mindkid/web dev",
    "dev:admin": "pnpm --filter @mindkid/admin dev",
    "dev:worker": "pnpm --filter @mindkid/worker dev",
    "dev:all": "pnpm --parallel --filter './apps/*' dev",
    "build": "pnpm --recursive --if-present run build",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "lint:deps": "depcruise apps packages scripts --config .dependency-cruiser.cjs",
    "typecheck": "tsc --noEmit && pnpm --parallel --filter './apps/*' run typecheck",
    "test": "NODE_OPTIONS=--max-old-space-size=4096 vitest run --bail 1",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "pnpm lint && pnpm lint:deps && pnpm typecheck",
    "db:generate": "pnpm --filter @mindkid/db run generate",
    "db:migrate": "pnpm --filter @mindkid/db run migrate",
    "db:seed": "pnpm --filter @mindkid/db run seed && pnpm --filter @mindkid/content-build run seed:all",
    "db:local:init": "pnpm --filter @mindkid/db run sqlite:init",
    "db:local:seed": "pnpm --filter @mindkid/db run sqlite:seed && DB_CONNECTION=sqlite pnpm --filter @mindkid/content-build run seed:all",
    "verify:cf-budget": "tsx scripts/deploy/verify-cf-budget.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "~2.6.8",
    "@mindkid/config": "workspace:*",
    "@mindkid/content": "workspace:*",
    "@mindkid/content-build": "workspace:*",
    "@mindkid/game-engine": "workspace:*",
    "@mindkid/shared": "workspace:*",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "5.1.0",
    "dependency-cruiser": "18.8.0-beta-2",
    "lefthook": "^2.2.2",
    "postgres": "^4.1.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "ultracite": "~8.2.1",
    "vitest": "^5.1.0",
    "wrangler": "4.168.0"
  }
}
