# TLS server for the admin surface: a static tree, no process behind it.
# Spec: docs/specs/01-platform/server-provisioning.md §4 step 8
# Rules: BR-ARB-01, BR-ARB-03 (admin is files, not a Node process)
#
# Rendered and enabled ONLY once /etc/letsencrypt/live/${ADMIN_DOMAIN} exists.

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${ADMIN_DOMAIN};

    ssl_certificate /etc/letsencrypt/live/${ADMIN_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${ADMIN_DOMAIN}/privkey.pem;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header Cross-Origin-Opener-Policy same-origin always;

    root /opt/mindkid/current/apps/admin/.output/public;
    index index.html;

    location /_nuxt/ {
        expires 1y;
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
