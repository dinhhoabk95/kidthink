# TLS server for the public site.
# Spec: docs/specs/01-platform/server-provisioning.md §4 step 8, §7.3
#
# Rendered and enabled ONLY once /etc/letsencrypt/live/${SITE_DOMAIN} exists.
# Enabling it earlier makes the whole nginx configuration invalid, which takes
# the other domain down with it.

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${SITE_DOMAIN};

    ssl_certificate /etc/letsencrypt/live/${SITE_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${SITE_DOMAIN}/privkey.pem;

    # A site handling children's data should never be reachable over cleartext
    # after the first visit.
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options SAMEORIGIN always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header Cross-Origin-Opener-Policy same-origin always;

    client_max_body_size 8m;

    location /_nuxt/ {
        alias /opt/mindkid/current/apps/web/.output/public/_nuxt/;
        expires 1y;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # The health endpoint is what the release smoke gate calls; rate limiting it
    # would make a release fail for the wrong reason.
    location = /api/guest/health {
        proxy_pass http://127.0.0.1:3000;
        include /etc/nginx/snippets/mindkid-proxy.conf;
    }

    location ~* ^/api/guest/auth/ {
        limit_req zone=mindkid_auth burst=10 nodelay;
        proxy_pass http://127.0.0.1:3000;
        include /etc/nginx/snippets/mindkid-proxy.conf;
    }

    location /api/ {
        limit_req zone=mindkid_api burst=30 nodelay;
        proxy_pass http://127.0.0.1:3000;
        include /etc/nginx/snippets/mindkid-proxy.conf;
    }

    location / {
        proxy_pass http://127.0.0.1:3000;
        include /etc/nginx/snippets/mindkid-proxy.conf;
    }
}
