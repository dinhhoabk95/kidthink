#!/usr/bin/env bash
# Fake docker for the release harness.
#
# Emulates only what build.sh asks of it: run a command in an image with the
# release directory mounted at /workspace. Behaviour is steered by files in
# $MK_FAKE_STATE so a test can make the build fail without touching the script.
set -uo pipefail

state="${MK_FAKE_STATE:?MK_FAKE_STATE must be set}"
printf 'docker %s\n' "$*" >>"${state}/docker.calls"

case "${1:-}" in
  compose|ps|exec) exit 0 ;;
esac

# Find the host path mounted at /workspace.
workspace=""
prev=""
for arg in "$@"; do
  if [ "${prev}" = "-v" ]; then
    case "${arg}" in
      *:/workspace) workspace="${arg%%:/workspace}" ;;
    esac
  fi
  prev="${arg}"
done

command_text="${*: -1}"

if [ -f "${state}/build_fails" ] && [[ "${command_text}" == *"pnpm build"* ]]; then
  echo "fake docker: build killed" >&2
  exit 137
fi

if [ -f "${state}/migrate_fails" ] && [[ "${command_text}" == *"db:migrate"* ]]; then
  echo "fake docker: migration failed" >&2
  exit 1
fi

# A successful build leaves artefacts that satisfy release_has_artifacts and
# smoke_release_artifacts (BR-DEP-15) unless a negative test flag is set.
if [[ "${command_text}" == *"pnpm build"* ]] && [ -n "${workspace}" ]; then
  mkdir -p "${workspace}/apps/web/.output/server" \
           "${workspace}/apps/web/.output/public/_nuxt" \
           "${workspace}/apps/admin/.output/public/_nuxt" \
           "${workspace}/apps/worker/dist"
  if [ -f "${state}/artifact_server_dirname_leak" ]; then
    echo "export const dir = __dirname;" >"${workspace}/apps/web/.output/server/index.mjs"
  else
    echo "export const serverReady = true;" >"${workspace}/apps/web/.output/server/index.mjs"
  fi
  echo "export const webClient = true;" >"${workspace}/apps/web/.output/public/_nuxt/entry.test.js"
  echo '<!doctype html><html><head><link rel="stylesheet" href="/_nuxt/entry.test.css"></head><body><div id="__nuxt"></div></body></html>' \
    >"${workspace}/apps/admin/.output/public/index.html"
  if [ -f "${state}/artifact_missing_css" ]; then
    echo "body{margin:0}" >"${workspace}/apps/admin/.output/public/_nuxt/entry.test.css"
  else
    head -c 105000 /dev/zero | tr '\0' 'a' >"${workspace}/apps/admin/.output/public/_nuxt/entry.test.css"
  fi
  if [ -f "${state}/artifact_client_server_leak" ]; then
    echo "import gyp from 'node-gyp-build'; export const x = gyp;" \
      >"${workspace}/apps/admin/.output/public/_nuxt/entry.test.js"
  else
    echo "export const adminClient = true;" >"${workspace}/apps/admin/.output/public/_nuxt/entry.test.js"
  fi
  echo "// built" >"${workspace}/apps/worker/dist/index.js"
fi

if [[ "${command_text}" == *"db:migrate"* ]]; then
  echo "migration applied" >>"${state}/migrations.applied"
fi

exit 0
