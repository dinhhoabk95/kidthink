# [web, worker] Chế độ chạy; quyết định biến nào bắt buộc ở máy chủ (always)
NODE_ENV=development

# [web, worker] Cổng loopback của tiến trình, xem server-provisioning.md §7.3 (always)
PORT=3000

# [web, worker] Địa chỉ công khai của site; dùng cho SEO, sitemap, OAuth callback, URL tài sản (always)
SITE_URL=http://localhost:3000

# [web] Danh sách origin được phép gọi API; web dùng cho CORS và CSRF allowlist (always)
NUXT_ALLOWED_ORIGINS=example_value

# [admin] Origin tuyệt đối của web API được nướng vào static admin SPA (always)
NUXT_PUBLIC_API_BASE_URL=https://example.com/endpoint

# [web, worker] Chuỗi kết nối PostgreSQL của tiến trình di trú và ứng dụng (always)
DATABASE_URL=postgres://postgres:postgres@localhost:5433/mindkid

# [web, worker] Chuỗi kết nối quyền hẹp cho ứng dụng (always)
DATABASE_URL_APP=https://example.com/endpoint

# [web, worker] Chuỗi kết nối Valkey cho cache, hàng đợi và giới hạn tần suất (always)
VALKEY_URL=valkey://127.0.0.1:6380

# [web] Mật khẩu niêm phong cookie phiên; tên do thư viện session cố định (always)
NUXT_SESSION_PASSWORD=replace_with_at_least_32_bytes_cryptographic_secret_key!

# [web] Khoá ký chứng cứ vượt cổng người lớn (always)
PARENT_GATE_SECRET=replace_with_at_least_32_bytes_cryptographic_secret_key!

# [web] Khoá mã hoá bí mật TOTP lưu trong cơ sở dữ liệu (always)
MFA_ENCRYPTION_KEY=replace_with_at_least_32_bytes_cryptographic_secret_key!

# [web] Khoá kiểm chữ ký webhook thanh toán, dùng chung khi không có khoá riêng nhà cung cấp (production)
PAYMENT_WEBHOOK_SECRET=replace_with_at_least_32_bytes_cryptographic_secret_key!

# [web] Khoá webhook riêng của PayOS; thiếu thì dùng PAYMENT_WEBHOOK_SECRET (optional)
PAYMENT_PAYOS_WEBHOOK_SECRET=replace_with_at_least_32_bytes_cryptographic_secret_key!

# [web] Khoá webhook riêng của VNPay; thiếu thì dùng PAYMENT_WEBHOOK_SECRET (optional)
PAYMENT_VNPAY_WEBHOOK_SECRET=replace_with_at_least_32_bytes_cryptographic_secret_key!

# [web] Khoá webhook riêng của MoMo; thiếu thì dùng PAYMENT_WEBHOOK_SECRET (optional)
PAYMENT_MOMO_WEBHOOK_SECRET=replace_with_at_least_32_bytes_cryptographic_secret_key!

# [web] Mã ngân hàng in trên mã QR chuyển khoản thủ công (production)
VIETQR_BANK_ID=example_value

# [web] Tên ngân hàng hiển thị kèm mã QR (production)
VIETQR_BANK_NAME=example_value

# [web] Số tài khoản nhận chuyển khoản (production)
VIETQR_ACCOUNT_NO=example_value

# [web] Tên chủ tài khoản nhận chuyển khoản (production)
VIETQR_ACCOUNT_NAME=example_value

# [web, worker] Địa chỉ gốc phục vụ tài sản; thiếu thì rơi về SITE_URL (production)
STORAGE_BASE_URL=http://localhost:3000/assets

# [web, worker] Khoá ký URL tài sản riêng tư của trẻ; không có mặc định (always)
STORAGE_SIGNING_SECRET=replace_with_at_least_32_bytes_cryptographic_secret_key!

# [web, worker] Tên bucket chứa tài sản công khai (production)
AWS_S3_PUBLIC_BUCKET=example_value

# [web, worker] Tên bucket chứa tài sản riêng tư (production)
AWS_S3_PRIVATE_BUCKET=example_value

# [web, worker] Khoá truy cập S3; thiếu cả cặp thì tầng lưu trữ chạy chế độ cục bộ (optional)
AWS_ACCESS_KEY_ID=example_value

# [web, worker] Bí mật truy cập S3, đi cùng AWS_ACCESS_KEY_ID (optional)
AWS_SECRET_ACCESS_KEY=replace_with_at_least_32_bytes_cryptographic_secret_key!

# [web] Định danh ứng dụng OAuth Google; thiếu thì nút đăng nhập Google tắt (optional)
GOOGLE_CLIENT_ID=example_value

# [web] Bí mật OAuth Google, đi cùng GOOGLE_CLIENT_ID (optional)
GOOGLE_CLIENT_SECRET=replace_with_at_least_32_bytes_cryptographic_secret_key!

# [web] Định danh ứng dụng OAuth Facebook; thiếu thì nút đăng nhập Facebook tắt (optional)
FACEBOOK_CLIENT_ID=example_value

# [web] Bí mật OAuth Facebook, đi cùng FACEBOOK_CLIENT_ID (optional)
FACEBOOK_CLIENT_SECRET=replace_with_at_least_32_bytes_cryptographic_secret_key!

# [web] Khoá mã hoá token thiết bị nhận thông báo đẩy (always)
NUXT_NOTIFICATION_TOKEN_ENCRYPTION_KEY=replace_with_at_least_32_bytes_cryptographic_secret_key!

# [web] Khoá mã hoá dữ liệu FCM; thiếu thì tầng thông báo đẩy tắt (optional)
FCM_ENCRYPTION_SECRET=replace_with_at_least_32_bytes_cryptographic_secret_key!

# [web, worker] Token bot gửi cảnh báo vận hành (optional)
TELEGRAM_BOT_TOKEN=replace_with_at_least_32_bytes_cryptographic_secret_key!

# [web, worker] Nhóm nhận cảnh báo vận hành, đi cùng TELEGRAM_BOT_TOKEN (optional)
TELEGRAM_CHAT_ID=example_value

# [web, worker] Địa chỉ ping báo hiệu tiến trình định kỳ còn sống (optional)
HEALTHCHECKS_PING_URL=https://example.com/endpoint

# [web, worker] Định danh check tương ứng trên dịch vụ theo dõi (optional)
HEALTHCHECKS_CHECK_UUID=example_value

# [web, worker] Hộp thư nhận cảnh báo khi kênh chính im (optional)
OPERATIONS_ALERT_EMAIL=dev@mindkid.vn

# [web, worker] Đích gửi lỗi phía máy chủ; thiếu thì tắt thu thập (optional)
SENTRY_DSN=https://example.com/endpoint

# [web, worker] Đích gửi lỗi phía trình duyệt (optional)
NUXT_PUBLIC_SENTRY_DSN=https://example.com/endpoint

# [web, worker] Tỉ lệ lấy mẫu lỗi trình duyệt; thiếu thì dùng mặc định trong mã (optional)
CLIENT_ERROR_SAMPLING_RATE=example_value

# [worker] Khoá mã hoá bản sao lưu cơ sở dữ liệu (always)
BACKUP_ENCRYPTION_KEY=replace_with_at_least_32_bytes_cryptographic_secret_key!

# [web] Tài khoản quản trị đầu tiên, chỉ đọc khi chạy lệnh gieo dữ liệu (optional)
INITIAL_ADMIN_EMAIL=dev@mindkid.vn

# [web] Mật khẩu tài khoản quản trị đầu tiên, chỉ đọc khi chạy lệnh gieo dữ liệu (optional)
INITIAL_ADMIN_PASSWORD=replace_with_at_least_32_bytes_cryptographic_secret_key!

# [web, worker] Mã commit của bản đang chạy; quy trình phát hành đặt vào để truy vết (optional)
GIT_SHA=example_value

# [web, worker] Đường dẫn pull request sinh ra bản này, dùng khi điều tra sự cố (optional)
PR_URL=https://example.com/endpoint
