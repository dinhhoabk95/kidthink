# [web, admin, worker] Môi trường thực thi của tiến trình (always)
NODE_ENV=development

# [web, admin, worker] Cổng lắng nghe của HTTP server (always)
PORT=3000

# [web, admin] Danh sách domain được phép gọi API (CORS whitelist) (production)
NUXT_ALLOWED_ORIGINS=example_value

# [web, admin, worker] Chuỗi kết nối PostgreSQL (postgres://...) (always)
DATABASE_URL=postgres://postgres:postgres@localhost:5433/mindkid

# [web, admin, worker] Số kết nối tối thiểu trong DB pool (production)
DATABASE_POOL_MIN=5

# [web, admin, worker] Số kết nối tối đa trong DB pool (production)
DATABASE_POOL_MAX=20

# [web, admin, worker] Chuỗi kết nối Valkey/Redis cho cache và queue (always)
VALKEY_URL=valkey://127.0.0.1:6380

# [web, admin] Mật khẩu niêm phong cookie session (tối thiểu 32 byte) (always)
NUXT_SESSION_PASSWORD=replace_with_at_least_32_bytes_cryptographic_secret_key!

# [web] Khoá ký JWT access/refresh token cho người dùng web (always)
WEB_JWT_SECRET=replace_with_at_least_32_bytes_cryptographic_secret_key!

# [admin, web] Khoá ký JWT token cho manager / super admin (always)
ADMIN_JWT_SECRET=replace_with_at_least_32_bytes_cryptographic_secret_key!

# [web] Bí mật HMAC cho Parent Gate token (always)
PARENT_GATE_SECRET=replace_with_at_least_32_bytes_cryptographic_secret_key!

# [web] Khoá mã hoá MFA TOTP secrets (tối thiểu 32 byte) (always)
MFA_ENCRYPTION_KEY=replace_with_at_least_32_bytes_cryptographic_secret_key!

# [web] Khoá xác thực webhook cổng thanh toán (production)
PAYMENT_WEBHOOK_SECRET=replace_with_at_least_32_bytes_cryptographic_secret_key!

# [web, admin] Địa chỉ công khai của site web chính (https://...) (always)
SITE_URL=http://localhost:3000

# [web, admin] Địa chỉ công khai của admin site (https://...) (always)
ADMIN_SITE_URL=http://localhost:3002

# [web, admin, worker] Driver lưu trữ tệp (local hoặc s3) (always)
STORAGE_DRIVER=local

# [web, admin, worker] Tên S3 Bucket lưu trữ ảnh và assets (when enabled by STORAGE_DRIVER)
S3_BUCKET=example_value

# [web, admin, worker] AWS Region của S3 bucket (when enabled by STORAGE_DRIVER)
S3_REGION=example_value

# [web, admin, worker] S3 Access Key ID (when enabled by STORAGE_DRIVER)
S3_ACCESS_KEY_ID=example_value

# [web, admin, worker] S3 Secret Access Key (when enabled by STORAGE_DRIVER)
S3_SECRET_ACCESS_KEY=replace_with_at_least_32_bytes_cryptographic_secret_key!

# [web, admin, worker] S3 custom endpoint cho MinIO hoặc Cloudflare R2 (when enabled by STORAGE_DRIVER)
S3_ENDPOINT=https://example.com/endpoint

# [web, worker] Địa chỉ máy chủ SMTP gửi email (production)
SMTP_HOST=example_value

# [web, worker] Cổng máy chủ SMTP (587, 465, 25, 1025) (production)
SMTP_PORT=3000

# [web, worker] Tên đăng nhập SMTP (production)
SMTP_USER=example_value

# [web, worker] Mật khẩu SMTP (production)
SMTP_PASSWORD=replace_with_at_least_32_bytes_cryptographic_secret_key!

# [web, worker] Địa chỉ email người gửi mặc định (production)
SMTP_FROM=dev@mindkid.vn

# [web, worker] Google Firebase Project ID cho Web Push / FCM (when enabled by FCM_ENABLED)
FCM_PROJECT_ID=example_value

# [web, worker] FCM Service Account Client Email (when enabled by FCM_ENABLED)
FCM_CLIENT_EMAIL=dev@mindkid.vn

# [web, worker] FCM Service Account Private Key PEM (when enabled by FCM_ENABLED)
FCM_PRIVATE_KEY=replace_with_at_least_32_bytes_cryptographic_secret_key!

# [web, worker] Khoá mã hoá FCM token (tối thiểu 32 byte) (when enabled by FCM_ENABLED)
FCM_ENCRYPTION_KEY=replace_with_at_least_32_bytes_cryptographic_secret_key!

# [worker] Khoá mã hoá AES-256-GCM file dump backup database (32 byte) (always)
BACKUP_ENCRYPTION_KEY=replace_with_at_least_32_bytes_cryptographic_secret_key!

# [worker] Đường dẫn thư mục lưu trữ backup trên máy chủ (production)
BACKUP_DIR=example_value

# [worker] Webhook gửi cảnh báo hệ thống (Telegram/Slack) (when enabled by ALERT_ENABLED)
ALERT_WEBHOOK_URL=https://example.com/endpoint

# [web] Google OAuth Client ID (when enabled by OAUTH_GOOGLE)
GOOGLE_CLIENT_ID=example_value

# [web] Google OAuth Client Secret (when enabled by OAUTH_GOOGLE)
GOOGLE_CLIENT_SECRET=replace_with_at_least_32_bytes_cryptographic_secret_key!

# [web] Facebook App Client ID (when enabled by OAUTH_FACEBOOK)
FACEBOOK_CLIENT_ID=example_value

# [web] Facebook App Client Secret (when enabled by OAUTH_FACEBOOK)
FACEBOOK_CLIENT_SECRET=replace_with_at_least_32_bytes_cryptographic_secret_key!

# [web] Apple Services ID (when enabled by OAUTH_APPLE)
APPLE_CLIENT_ID=example_value

# [web] Apple Developer Team ID (when enabled by OAUTH_APPLE)
APPLE_TEAM_ID=example_value

# [web] Apple Sign-in Key ID (when enabled by OAUTH_APPLE)
APPLE_KEY_ID=example_value

# [web] Apple Sign-in Private Key (.p8) (when enabled by OAUTH_APPLE)
APPLE_PRIVATE_KEY=replace_with_at_least_32_bytes_cryptographic_secret_key!

# [web] Cờ bật tính năng offline pack cho PWA (production)
FEATURE_PWA_OFFLINE=true

# [web, admin] Cờ bật tạo game tuỳ chỉnh cho người dạy (production)
FEATURE_CUSTOM_GAMES=true

# [web] Cờ bật trợ lý AI soạn bài học (production)
FEATURE_AI_ASSISTANT=true

# [web, worker] Cờ bật tự động thanh toán gia hạn (production)
FEATURE_RECURRING_BILLING=true

# [web] API Key gọi OpenAI / AI Planner (when enabled by FEATURE_AI_ASSISTANT)
OPENAI_API_KEY=replace_with_at_least_32_bytes_cryptographic_secret_key!

# [web] Base URL cho AI service proxy (when enabled by FEATURE_AI_ASSISTANT)
OPENAI_BASE_URL=https://example.com/endpoint

# [web, admin] Email tài khoản admin ban đầu khi chạy seed (when enabled by SEED_ENABLED)
SEEDED_ADMIN_EMAIL=dev@mindkid.vn

# [web, admin] Mật khẩu tài khoản admin ban đầu khi chạy seed (when enabled by SEED_ENABLED)
SEEDED_ADMIN_PASSWORD=replace_with_at_least_32_bytes_cryptographic_secret_key!
