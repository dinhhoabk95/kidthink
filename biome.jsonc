{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "root": true,
  "extends": ["ultracite/core", "ultracite/vue"],
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "javascript": {
    "globals": [
      "$fetch",
      "apiFetch",
      "apiUrl",
      "useApiFetch",
      "useAdminAuth",
      "useRoute",
      "useRouter",
      "navigateTo",
      "useToast",
      "useFetch",
      "useAsyncData",
      "defineNuxtRouteMiddleware",
      "definePageMeta",
      "clearError",
      "createError",
      "useCookie",
      "useRuntimeConfig",
      "useHead",
      "useSeoMeta",
      "watch",
      "ref",
      "computed",
      "onMounted",
      "onUnmounted",
      "nextTick",
      "defineProps",
      "defineEmits",
      "withDefaults",
      "$event",
      "defineEventHandler",
      "readBody",
      "getQuery",
      "getRouterParam",
      "getHeader",
      "setHeader",
      "deleteCookie",
      "getCookie",
      "setCookie",
      "sendRedirect",
      "sendNoContent",
      "setResponseStatus",
      "setUserSession",
      "getUserSession",
      "clearUserSession",
      "useUserSession",
      "defineNitroPlugin",
      "useStorage",
      "readMultipartFormData"
    ]
  },

  // Zero-config là mặc định. Mỗi override dưới đây phải trỏ được về một contract
  // trong docs/specs/ — ❌ NEVER nới rule chỉ vì code hiện tại đang vi phạm.
  "overrides": [
    {
      "includes": ["*.vue", "**/*.vue"],
      "linter": {
        "rules": {
          "suspicious": {
            "useStrictMode": "off"
          }
        }
      }
    },
    {
      // monorepo-package-architecture.md §8: "Export — Chỉ qua src/index.ts,
      // không import path sâu". Kiến trúc BẮT BUỘC barrel file ở đúng một chỗ
      // mỗi package, nên noBarrelFile không áp được cho file đó.
      // Ngoài src/index.ts, rule vẫn bật.
      //
      // `src/client.ts` là cửa thứ hai, CHỜ RATIFY §8 — chưa có trong contract.
      // Lý do mở: §8 chỉ cấm import path sâu vào nội bộ package, nhưng một cửa
      // duy nhất buộc trang Vue phía client phải nuốt cả 11 module chạm node:
      // builtin và package máy chủ trong barrel `@mindkid/shared` (Vite không
      // tree-shake ở dev) — apps/web chết lúc khởi tạo, và bản build từng ship
      // native addon argon2 xuống trình duyệt. `client.ts` vẫn là bề mặt export
      // được khai báo trong `exports`, không phải path sâu vào internal.
      "includes": ["packages/*/src/index.ts", "packages/*/src/client.ts"],
      "linter": {
        "rules": {
          "performance": {
            "noBarrelFile": "off"
          }
        }
      }
    },
    {
      "includes": ["packages/auth/src/totp.ts"],
      "linter": {
        "rules": {
          "suspicious": {
            "noBitwiseOperators": "off"
          }
        }
      }
    },
    {
      // skill-dataset-model.md §3: "File: packages/db/src/seed-content/skills/<c>/<strand>/<SKILL>.ts".
      // Tên file kỹ năng mang mã taxonomy bất biến C[1-6].[STRAND].[NN].ts.
      "includes": ["packages/db/src/seed-content/skills/**/*.ts"],
      "linter": {
        "rules": {
          "style": {
            "useFilenamingConvention": "off"
          }
        }
      }
    }
  ]
}
