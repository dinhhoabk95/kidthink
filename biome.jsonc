{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "root": true,
  "extends": ["ultracite/core", "ultracite/vue"],
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "javascript": {
    "globals": [
      "$fetch",
      "apiFetch",
      "apiUrl",
      "useApiFetch",
      "useAdminAuth",
      "useRoute",
      "useRouter",
      "navigateTo",
      "useToast",
      "useFetch",
      "useAsyncData",
      "defineNuxtRouteMiddleware",
      "definePageMeta",
      "clearError",
      "createError",
      "useCookie",
      "useRuntimeConfig",
      "useHead",
      "useSeoMeta",
      "watch",
      "ref",
      "computed",
      "onMounted",
      "onUnmounted",
      "nextTick",
      "defineProps",
      "defineEmits",
      "withDefaults",
      "$event"
    ]
  },

  // Zero-config là mặc định. Mỗi override dưới đây phải trỏ được về một contract
  // trong docs/specs/ — ❌ NEVER nới rule chỉ vì code hiện tại đang vi phạm.
  "overrides": [
    {
      "includes": ["*.vue", "**/*.vue"],
      "linter": {
        "rules": {
          "suspicious": {
            "useStrictMode": "off"
          }
        }
      }
    },
    {
      // monorepo-package-architecture.md §8: "Export — Chỉ qua src/index.ts,
      // không import path sâu". Kiến trúc BẮT BUỘC barrel file ở đúng một chỗ
      // mỗi package, nên noBarrelFile không áp được cho file đó.
      // Ngoài src/index.ts, rule vẫn bật.
      "includes": ["packages/*/src/index.ts"],
      "linter": {
        "rules": {
          "performance": {
            "noBarrelFile": "off"
          }
        }
      }
    },
    {
      "includes": ["packages/auth/src/totp.ts"],
      "linter": {
        "rules": {
          "suspicious": {
            "noBitwiseOperators": "off"
          }
        }
      }
    }
  ]
}
