{
  "name": "@mindkid/game-engine",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "gen:templates": "tsx scripts/gen-templates.ts",
    "gen:engine-index": "tsx scripts/gen-engine-index.ts",
    "check:render": "tsx scripts/check-render.ts",
    "check:engine-specs": "tsx scripts/check-engine-specs.ts",
    "test": "vitest run",
    "new:template": "tsx scripts/create-template.ts"
  },
  "devDependencies": {
    "@mindkid/config": "workspace:*",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "dependencies": {
    "@mindkid/emoji": "workspace:*",
    "@mindkid/shared": "workspace:*",
    "zod": "catalog:",
    "zod-to-json-schema": "catalog:"
  },
  "exports": {
    ".": "./src/index.ts",
    "./tokens": "./src/systems/designTokens.ts",
    "./contracts": "./src/contracts/index.ts",
    "./registry": "./src/generated/template-registry.ts",
    "./generators": "./src/generators/index.ts",
    "./render": "./src/render/index.ts",
    "./runtime": "./src/runtime.ts",
    "./loader": "./src/generated/session-loader.ts"
  },
  "imports": {
    "#src/*.js": "./src/*.ts",
    "#src/*": "./src/*.ts",
    "#tests/*": "./tests/*.ts",
    "#scripts/*": "./scripts/*.ts"
  }
}
