{
  "name": "@mindkid/content-build",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./gates/*": "./src/gates/*.ts",
    "./cli/*": "./src/cli/*.ts",
    "./seed-master/*": "./src/seed-master/*.ts",
    "./thresholds/*": "./src/thresholds/*"
  },
  "dependencies": {
    "@mindkid/auth": "workspace:*",
    "@mindkid/config": "workspace:*",
    "@mindkid/content": "workspace:*",
    "@mindkid/db": "workspace:*",
    "@mindkid/errors": "workspace:*",
    "@mindkid/game-engine": "workspace:*",
    "@mindkid/shared": "workspace:*",
    "@mindkid/taxonomy": "workspace:*",
    "drizzle-orm": "catalog:",
    "postgres": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "vitest": "catalog:",
    "typescript": "catalog:"
  },
  "scripts": {
    "test": "vitest run",
    "seed:all": "tsx src/cli/seed-all.ts"
  },
  "imports": {
    "#src/*": "./src/*.ts",
    "#tests/*": "./tests/*.ts"
  }
}
