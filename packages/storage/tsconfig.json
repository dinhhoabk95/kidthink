{
  // Toàn bộ flag compiler sống ở `@mindkid/config/tsconfig.base.json` —
  // ❌ NEVER khai lại flag ở đây. File này chỉ nói **những file nào** thuộc
  // package, vì `include`/`exclude` của tsconfig cha luôn được TypeScript giải
  // theo thư mục của file cha, nên chúng không thể dùng chung.
  "extends": "@mindkid/config/tsconfig.base.json",
  "include": ["src/**/*.ts", "tests/**/*.ts", "scripts/**/*.ts", "*.ts"],
  // Fixture của cổng là mẫu văn bản cho cổng quét, cố ý sai kiểu — xem
  // AGENTS.md §"Cổng contract là test vitest".
  "exclude": ["tests/**/fixtures/**"]
}
