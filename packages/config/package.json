{
  "name": "@mindkid/config",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./constants": "./src/constants.ts",
    "./tsconfig.base.json": "./tsconfig.base.json",
    "./vitest": "./vitest/base.ts",
    "./paths": "./src/repo-paths.ts"
  },
  "devDependencies": {
    "vitest": "catalog:"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "gen:env-example": "node scripts/generate-env-example.ts"
  },
  "imports": {
    "#src/*": "./src/*.ts",
    "#tests/*": "./tests/*.ts",
    "#scripts/*": "./scripts/*.ts"
  }
}
