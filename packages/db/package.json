{
  "name": "@mindkid/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./seed": "./src/seed.ts"
  },
  "dependencies": {
    "@mindkid/adaptive": "workspace:*",
    "@mindkid/auth": "workspace:*",
    "@mindkid/config": "workspace:*",
    "@mindkid/errors": "workspace:*",
    "@mindkid/shared": "workspace:*",
    "@mindkid/taxonomy": "workspace:*",
    "drizzle-orm": "catalog:",
    "postgres": "catalog:"
  },
  "devDependencies": {
    "drizzle-kit": "catalog:",
    "fast-check": "catalog:"
  },
  "scripts": {
    "test": "vitest run",
    "generate": "drizzle-kit generate --config drizzle.config.ts",
    "migrate": "tsx scripts/migrate.ts",
    "seed": "tsx src/seed.ts",
    "replay:adaptive": "tsx scripts/replay-adaptive.ts"
  },
  "imports": {
    "#src/*": "./src/*.ts",
    "#tests/*": "./tests/*.ts",
    "#scripts/*": "./scripts/*.ts"
  }
}
