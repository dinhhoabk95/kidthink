{
  "name": "@mindkid/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./seed": "./src/seed.ts"
  },
  "dependencies": {
    "@mindkid/adaptive": "workspace:*",
    "@mindkid/auth": "workspace:*",
    "@mindkid/config": "workspace:*",
    "@mindkid/game-engine": "workspace:*",
    "@mindkid/moderation": "workspace:*",
    "@mindkid/queue": "workspace:*",
    "@mindkid/shared": "workspace:*",
    "@mindkid/storage": "workspace:*",
    "@mindkid/taxonomy": "workspace:*",
    "drizzle-orm": "catalog:",
    "postgres": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@mindkid/shared": "workspace:*",
    "drizzle-kit": "catalog:",
    "fast-check": "catalog:"
  },
  "scripts": {
    "test": "vitest run",
    "generate": "drizzle-kit generate --config drizzle.config.ts",
    "migrate": "tsx scripts/migrate.ts",
    "seed": "tsx src/seed.ts",
    "seed:check": "tsx src/seed-content/cli/seed-check.ts",
    "seed:content": "tsx src/seed-content/cli/seed-content.ts",
    "seed:report": "tsx src/seed-content/cli/seed-report.ts",
    "report:tags": "tsx scripts/report-tag-vocabulary.ts",
    "replay:adaptive": "tsx scripts/replay-adaptive.ts",
    "check:theme-registry": "vitest run tests/gates/theme-registry.test.ts",
    "check:engine-depth": "tsx src/seed-content/cli/check-engine-depth.ts",
    "check:lesson-supply": "tsx src/seed-content/cli/check-lesson-supply.ts",
    "check:skill-quota": "tsx scripts/check-skill-quota.ts",
    "check:go-live": "tsx src/seed-content/cli/check-go-live.ts",
    "check:round-sets": "tsx src/seed-content/gates/round-sets.ts",
    "check:legacy-v1": "tsx src/seed-content/gates/legacy-v1-coverage.ts",
    "check:engine-allocation": "tsx src/seed-content/gates/allocation.ts",
    "check:age-band-fit": "tsx src/seed-content/gates/age-band-fit.ts",
    "check:skill-progression": "tsx src/seed-content/gates/skill-progression.ts",
    "gen:levels": "tsx src/seed-content/cli/gen-levels.ts",
    "gen:corpus": "tsx src/seed-content/cli/gen-corpus.ts",
    "gen-level-allocation": "tsx scripts/gen-level-allocation.ts",
    "gen-skill-affinity": "tsx scripts/gen-skill-affinity.ts",
    "generate-skill-datasets": "tsx scripts/generate-skill-datasets.ts",
    "gen-pedagogy-45": "tsx scripts/gen-pedagogy-45.ts",
    "reset-content": "tsx scripts/reset-content.ts",
    "check:taxonomy-refs": "vitest run tests/gates/taxonomy-refs.test.ts"
  },
  "imports": {
    "#src/*": "./src/*.ts",
    "#tests/*": "./tests/*.ts",
    "#scripts/*": "./scripts/*.ts"
  }
}
