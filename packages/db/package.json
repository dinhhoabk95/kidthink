{
  "name": "@mindkid/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./manager": "./src/manager.ts",
    "./repositories": "./src/repositories/index.ts",
    "./seed": "./src/seed.ts"
  },
  "dependencies": {
    "@mindkid/adaptive": "workspace:*",
    "@mindkid/auth": "workspace:*",
    "@mindkid/config": "workspace:*",
    "@mindkid/errors": "workspace:*",
    "@mindkid/shared": "workspace:*",
    "@mindkid/taxonomy": "workspace:*",
    "drizzle-orm": "1.0.0-rc.5",
    "postgres": "^4.1.1"
  },
  "devDependencies": {
    "drizzle-kit": "1.0.0-rc.5",
    "fast-check": "^4.10.2"
  },
  "scripts": {
    "test": "vitest run",
    "generate": "drizzle-kit generate --config drizzle.config.ts",
    "migrate": "tsx scripts/migrate.ts",
    "seed": "tsx src/seed.ts",
    "sqlite:init": "DB_CONNECTION=sqlite tsx scripts/sqlite-local.ts init",
    "sqlite:seed": "DB_CONNECTION=sqlite tsx scripts/sqlite-local.ts seed"
  },
  "imports": {
    "#src/*": "./src/*.ts",
    "#tests/*": "./tests/*.ts",
    "#scripts/*": "./scripts/*.ts"
  }
}
