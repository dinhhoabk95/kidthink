{
  "name": "@mindkid/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./seed": "./src/seed.ts"
  },
  "dependencies": {
    "@mindkid/adaptive": "workspace:*",
    "@mindkid/auth": "workspace:*",
    "@mindkid/config": "workspace:*",
    "@mindkid/moderation": "workspace:*",
    "@mindkid/queue": "workspace:*",
    "@mindkid/shared": "workspace:*",
    "@mindkid/storage": "workspace:*",
    "@mindkid/taxonomy": "workspace:*",
    "drizzle-orm": "catalog:",
    "postgres": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@mindkid/shared": "workspace:*",
    "drizzle-kit": "catalog:",
    "fast-check": "catalog:"
  },
  "scripts": {
    "test": "vitest run",
    "generate": "drizzle-kit generate --config drizzle.config.ts",
    "migrate": "tsx scripts/migrate.ts",
    "seed": "tsx src/seed.ts",
    "report:tags": "tsx scripts/report-tag-vocabulary.ts",
    "replay:adaptive": "tsx scripts/replay-adaptive.ts",
    "gen-level-allocation": "tsx scripts/gen-level-allocation.ts",
    "gen-skill-affinity": "tsx scripts/gen-skill-affinity.ts",
    "generate-skill-datasets": "tsx scripts/generate-skill-datasets.ts"
  },
  "imports": {
    "#src/*": "./src/*.ts",
    "#tests/*": "./tests/*.ts",
    "#scripts/*": "./scripts/*.ts"
  }
}
