{
  // Lưới phủ typecheck của cả repo. Trước file này `pnpm check` chạy
  // `tsc` trên đúng 1/15 project — scripts/, *.config.ts và packages/*/tests/
  // đều nằm ngoài gate, nên `pnpm check` exit 0 với lỗi type thật.
  //
  // `include` cố ý dùng glob `packages/*`: package mới sinh ra là được phủ ngay,
  // ❌ không phải nhớ thêm tsconfig + script cho từng cái (thứ chắc chắn sẽ quên).
  //
  // apps/* KHÔNG nằm đây — Nuxt sinh tsconfig riêng ở .nuxt/. Cổng phủ chúng là
  // `pnpm typecheck` (`scripts/typecheck/typecheck-gate.ts`), chạy vue-tsc
  // trên từng project .nuxt/tsconfig.*.json. ❌ NEVER dùng `nuxt typecheck`:
  // nó nạp nuxt.config.ts nên chết vì thiếu env, và từng exit 0 im lặng.
  //
  // Mọi flag compiler sống ở packages/config/tsconfig.base.json — ❌ NEVER
  // khai lại ở đây.
  "extends": "./packages/config/tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@mindkid/adaptive": ["./packages/adaptive/src/index.ts"],
      "@mindkid/auth": ["./packages/auth/src/index.ts"],
      "@mindkid/cache": ["./packages/cache/src/index.ts"],
      "@mindkid/config": ["./packages/config/src/index.ts"],
      "@mindkid/config/vitest": ["./packages/config/vitest/base.ts"],
      "@mindkid/config/*": [
        "./packages/config/*",
        "./packages/config/src/*.ts"
      ],
      "@mindkid/db": ["./packages/db/src/index.ts"],
      "@mindkid/emoji": ["./packages/emoji/src/index.ts"],
      "@mindkid/game-engine": ["./packages/game-engine/src/index.ts"],
      "@mindkid/moderation": ["./packages/moderation/src/index.ts"],
      "@mindkid/notification": ["./packages/notification/src/index.ts"],
      "@mindkid/queue": ["./packages/queue/src/index.ts"],
      "@mindkid/shared": ["./packages/shared/src/index.ts"],
      "@mindkid/storage": ["./packages/storage/src/index.ts"],
      "@mindkid/taxonomy": ["./packages/taxonomy/src/index.ts"],
      "@mindkid/ui": ["./packages/ui/src/index.ts"]
    }
  },
  "include": [
    "scripts/**/*.ts",
    "infra/**/*.ts",
    "*.config.ts",
    "packages/*/src/**/*.ts",
    "packages/*/tests/**/*.ts",
    // Tooling của workspace (cổng chất lượng, generator, script vận hành) nằm
    // trong package sở hữu nó, không còn ở scripts/ gốc — vẫn phải được typecheck.
    "packages/*/scripts/**/*.ts",
    "packages/*/vitest/**/*.ts",
    // File config ở gốc mỗi workspace (vitest.config.ts, drizzle.config.ts,
    // app.config.ts). Trước dòng này 20 file như vậy không nằm trong bất kỳ
    // project nào — sửa sai kiểu ở đó không cổng nào báo.
    "packages/*/*.ts",
    "apps/*/vitest.config.ts"
  ],
  "exclude": [
    // Fixture của cổng lint là **mẫu văn bản** cho cổng quét, không phải code
    // chạy được: chúng cố ý import h3/zod mà package cổng không có, và ca âm cố ý
    // thiếu kiểu. Typecheck chúng là đo sai thứ.
    "packages/*/tests/**/fixtures/**",
    // Config của Nuxt layer (packages/ui) cần type Nuxt sinh ra lúc build app.
    // Ngoài app không có `nuxt/config` lẫn auto-import `defineAppConfig`, nên
    // chỗ kiểm chúng là project .nuxt/ của app nạp layer, không phải lưới này.
    "packages/*/nuxt.config.ts",
    "packages/*/app.config.ts"
  ]
}
