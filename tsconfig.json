{
  // Lưới phủ typecheck của cả repo. Trước file này `pnpm check` chạy
  // `tsc` trên đúng 1/15 project — scripts/, *.config.ts và packages/*/tests/
  // đều nằm ngoài gate, nên `pnpm check` exit 0 với lỗi type thật.
  //
  // `include` cố ý dùng glob `packages/*`: package mới sinh ra là được phủ ngay,
  // ❌ không phải nhớ thêm tsconfig + script cho từng cái (thứ chắc chắn sẽ quên).
  //
  // apps/* KHÔNG nằm đây — Nuxt sinh tsconfig riêng ở .nuxt/. Khi apps/web có
  // code thật, app đó tự khai script `typecheck` (`nuxt typecheck`) và
  // `pnpm --recursive run typecheck` nhặt lên.
  "extends": "./packages/config/tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["node"],
    // scripts/*.ts chạy trực tiếp bằng `node` (native TS strip-types, không qua
    // bundler) — Node ESM cần extension đầy đủ trên relative import
    // (`./lint-specs-lib.ts`), nên import trong scripts/ khai `.ts` tường minh.
    // Flag này yêu cầu noEmit (đã set ở trên) — an toàn vì đây là single-project
    // config, không có package nào dưới cây này thực sự emit output.
    "allowImportingTsExtensions": true,
    "baseUrl": ".",
    "paths": {
      "@mindkid/adaptive": ["./packages/adaptive/src/index.ts"],
      "@mindkid/config": ["./packages/config/src/index.ts"],
      "@mindkid/shared": ["./packages/shared/src/index.ts"],
      "@mindkid/taxonomy": ["./packages/taxonomy/src/index.ts"],
      "@mindkid/emoji": ["./packages/emoji/src/index.ts"],
      "@mindkid/db": ["./packages/db/src/index.ts"],
      "@mindkid/game-engine": ["./packages/game-engine/src/index.ts"],
      "@mindkid/storage": ["./packages/storage/src/index.ts"],
      "@mindkid/moderation": ["./packages/moderation/src/index.ts"],
      "@mindkid/ui": ["./packages/ui/src/index.ts"]
    }
  },
  "include": [
    "scripts/**/*.ts",
    "*.config.ts",
    "packages/*/src/**/*.ts",
    "packages/*/tests/**/*.ts"
  ],
  // Fixture của cổng lint là **mẫu văn bản** cho script quét, không phải code
  // chạy được: chúng cố ý import h3/zod mà scripts/ không có, và ca âm cố ý
  // thiếu kiểu. Typecheck chúng là đo sai thứ.
  "exclude": ["scripts/tests/fixtures/**"]
}
