{
  "name": "@mindkid/admin",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt generate",
    "dev": "nuxt dev --port 3001",
    "typecheck": "vue-tsc --noEmit -p .nuxt/tsconfig.app.json && vue-tsc --noEmit -p .nuxt/tsconfig.server.json && vue-tsc --noEmit -p .nuxt/tsconfig.shared.json && vue-tsc --noEmit -p .nuxt/tsconfig.node.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@mindkid/auth": "workspace:*",
    "@mindkid/emoji": "workspace:*",
    "@mindkid/errors": "workspace:*",
    "@mindkid/shared": "workspace:*",
    "@mindkid/ui": "workspace:*"
  },
  "devDependencies": {
    "@mindkid/config": "workspace:*",
    "@nuxt/fonts": "^1.2.0",
    "@nuxt/ui": "^4.12.2",
    "@t3-oss/env-nuxt": "^0.13.11",
    "nuxt": "^4.6.4",
    "tailwindcss": "^4.3.5",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14",
    "vue": "3.6.0-rc.15",
    "zod": "^4.6.7"
  }
}
