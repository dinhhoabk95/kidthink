# Security headers cho admin static SPA (Workers Static Assets).
# Admin không có Nitro server nên `nuxt-security` không chạy; file này là owner duy nhất của header.
# Spec: docs/SPEC.md D14, docs/specs/01-platform/release-deploy.md §7.2, BR-SEC-10.
# Giá trị chép từ cấu hình Nginx admin đã gỡ (infra/nginx/mindkid-admin.conf.tmpl).

/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Cross-Origin-Opener-Policy: same-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; base-uri 'self'; font-src 'self' https: data:; form-action 'self'; frame-ancestors 'none'; img-src 'self' data: https:; object-src 'none'; script-src 'self'; style-src 'self' https: 'unsafe-inline'; connect-src 'self' https:;

/_nuxt/*
  Cache-Control: public, max-age=31536000, immutable
