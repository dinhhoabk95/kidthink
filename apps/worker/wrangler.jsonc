{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "mindkid-worker",
  "main": "src/cloudflare-entry.ts",
  "compatibility_date": "2026-04-01",
  "compatibility_flags": ["nodejs_compat"],
  "define": {
    "import.meta.dirname": "\"/\"",
    "import.meta.filename": "\"/index.js\""
  },
  "workers_dev": false,
  "vars": {
    "MINDKID_RUNTIME": "cloudflare",
    "STORAGE_DRIVER": "d1-blobs"
  },
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB_CORE",
      "database_name": "mindkid-core",
      "database_id": "REPLACE_VIA_SYNC_WRANGLER_IDS"
    },
    {
      "binding": "DB_LOGS",
      "database_name": "mindkid-logs",
      "database_id": "REPLACE_VIA_SYNC_WRANGLER_IDS"
    },
    {
      "binding": "DB_BLOBS",
      "database_name": "mindkid-blobs",
      "database_id": "REPLACE_VIA_SYNC_WRANGLER_IDS"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "JOB_QUEUE_DO",
        "class_name": "JobQueueDO"
      },
      {
        "name": "AUTH_COORDINATOR",
        "class_name": "AuthCoordinatorDO"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1-sqlite-do",
      "new_sqlite_classes": ["JobQueueDO", "AuthCoordinatorDO"]
    }
  ]
}
