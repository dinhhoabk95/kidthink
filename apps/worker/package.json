{
  "name": "@mindkid/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "node scripts/build.mjs",
    "start": "node dist/index.js",
    "restore": "tsx src/backup/restore.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "backup:manual": "tsx src/scripts/backup-manual.ts"
  },
  "dependencies": {
    "@mindkid/cache": "workspace:*",
    "@mindkid/config": "workspace:*",
    "@mindkid/db": "workspace:*",
    "@mindkid/queue": "workspace:*",
    "@mindkid/shared": "workspace:*",
    "@mindkid/storage": "workspace:*",
    "argon2": "catalog:",
    "bullmq": "catalog:",
    "drizzle-orm": "catalog:",
    "ioredis": "catalog:",
    "postgres": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "esbuild": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "imports": {
    "#src/*": "./src/*.ts",
    "#tests/*": "./tests/*.ts"
  }
}
