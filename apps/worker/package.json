{
  "name": "@mindkid/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "node scripts/build.mjs",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@mindkid/audit": "workspace:*",
    "@mindkid/auth": "workspace:*",
    "@mindkid/cache": "workspace:*",
    "@mindkid/config": "workspace:*",
    "@mindkid/db": "workspace:*",
    "@mindkid/export": "workspace:*",
    "@mindkid/local-runtime": "workspace:*",
    "@mindkid/notification": "workspace:*",
    "@mindkid/play": "workspace:*",
    "@mindkid/queue": "workspace:*",
    "@mindkid/shared": "workspace:*",
    "@mindkid/storage": "workspace:*",
    "drizzle-orm": "1.0.0-rc.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  },
  "imports": {
    "#src/*": "./src/*.ts",
    "#tests/*": "./tests/*.ts"
